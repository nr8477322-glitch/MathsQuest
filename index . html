<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#58cc02">
<title>MathQuest 🇧🇫</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --green:#58cc02;
  --green-dark:#46a800;
  --blue:#1cb0f6;
  --orange:#ff9600;
  --purple:#ce82ff;
  --red:#ff4b4b;
  --bg:#f6f7fb;
  --text:#263238;
  --muted:#667085;
  --white:#fff;
  --border:#e5e7eb;
  --shadow:0 8px 25px rgba(0,0,0,.08);
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
}

button,input,textarea{font:inherit}

button{
  cursor:pointer;
  border:0;
}

.screen{
  display:none;
  min-height:100vh;
}

.screen.active{
  display:block;
}

/* START */

.start{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:25px;
  background:linear-gradient(135deg,#eaffdf,#f4fbff);
}

.start-card{
  width:100%;
  max-width:600px;
  background:white;
  border-radius:30px;
  padding:35px 25px;
  text-align:center;
  box-shadow:var(--shadow);
}

.logo{
  font-size:42px;
  font-weight:900;
  color:var(--green);
  margin-bottom:10px;
}

.subtitle{
  color:var(--muted);
  line-height:1.6;
  margin-bottom:25px;
}

.mascot{
  width:180px;
  height:180px;
  object-fit:contain;
  margin:10px auto 20px;
}

.main-btn{
  width:100%;
  padding:16px;
  border-radius:16px;
  background:var(--green);
  color:white;
  font-weight:800;
  font-size:18px;
  box-shadow:0 5px 0 var(--green-dark);
  margin-top:10px;
}

.main-btn:active{
  transform:translateY(3px);
  box-shadow:0 2px 0 var(--green-dark);
}

/* HEADER */

.header{
  background:white;
  border-bottom:1px solid var(--border);
  padding:15px 18px;
  position:sticky;
  top:0;
  z-index:20;
}

.header-inner{
  max-width:1100px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
}

.brand{
  color:var(--green);
  font-weight:900;
  font-size:23px;
}

.header-stats{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}

.stat-mini{
  background:#f3f4f6;
  border-radius:12px;
  padding:8px 11px;
  font-size:13px;
  font-weight:bold;
}

/* CONTAINER */

.container{
  width:100%;
  max-width:1100px;
  margin:auto;
  padding:25px 18px 60px;
}

/* CLASS */

.section-title{
  font-size:28px;
  font-weight:900;
  margin-bottom:8px;
}

.section-subtitle{
  color:var(--muted);
  margin-bottom:22px;
  line-height:1.5;
}

.class-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
  gap:14px;
}

.class-card{
  background:white;
  border:2px solid var(--border);
  border-radius:20px;
  padding:24px 12px;
  text-align:center;
  transition:.2s;
}

.class-card:hover{
  transform:translateY(-3px);
  border-color:var(--green);
}

.class-number{
  font-size:28px;
  font-weight:900;
  color:var(--green);
  margin-bottom:8px;
}

.class-desc{
  color:var(--muted);
  font-size:13px;
}

/* FORM */

.form-card{
  max-width:650px;
  margin:auto;
  background:white;
  padding:25px;
  border-radius:25px;
  box-shadow:var(--shadow);
}

.field{
  margin-bottom:18px;
}

.field label{
  display:block;
  font-weight:800;
  margin-bottom:7px;
}

.field input,
.field textarea{
  width:100%;
  padding:14px;
  border:2px solid var(--border);
  border-radius:13px;
  outline:none;
}

.field input:focus,
.field textarea:focus{
  border-color:var(--green);
}

.avatar-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.avatar-btn{
  padding:20px;
  border:2px solid var(--border);
  border-radius:18px;
  background:white;
  font-size:42px;
}

.avatar-btn.selected{
  border-color:var(--green);
  background:#efffe7;
}

/* HOME */

.hero{
  background:linear-gradient(135deg,#eaffdf,#f0faff);
  border-radius:25px;
  padding:25px;
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:20px;
}

.hero img{
  width:150px;
  height:150px;
  object-fit:contain;
}

.hero h1{
  margin-bottom:8px;
}

.hero p{
  color:var(--muted);
  line-height:1.5;
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-bottom:20px;
}

.big-stat{
  background:white;
  border-radius:18px;
  padding:18px;
  text-align:center;
  box-shadow:var(--shadow);
}

.big-stat strong{
  display:block;
  font-size:25px;
  color:var(--green);
  margin-bottom:5px;
}

.menu-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.menu-card{
  background:white;
  padding:22px;
  border-radius:20px;
  box-shadow:var(--shadow);
  border:2px solid transparent;
}

.menu-card:hover{
  border-color:var(--green);
}

.menu-icon{
  font-size:34px;
  margin-bottom:10px;
}

.menu-card h3{
  margin-bottom:7px;
}

.menu-card p{
  color:var(--muted);
  font-size:14px;
  line-height:1.5;
}

/* COURSES */

.course-list{
  display:grid;
  gap:13px;
}

.course-card{
  background:white;
  padding:18px;
  border-radius:18px;
  border:2px solid var(--border);
}

.course-card h3{
  margin-bottom:7px;
}

.course-card p{
  color:var(--muted);
  font-size:14px;
  margin-bottom:13px;
}

.small-btn{
  background:var(--green);
  color:white;
  padding:11px 15px;
  border-radius:12px;
  font-weight:bold;
}

.blue-btn{
  background:var(--blue);
}

.orange-btn{
  background:var(--orange);
}

/* LESSON */

.lesson{
  max-width:850px;
  margin:auto;
}

.lesson-card{
  background:white;
  border-radius:25px;
  padding:25px;
  box-shadow:var(--shadow);
}

.lesson-card h1{
  margin-bottom:10px;
}

.lesson-meta{
  color:var(--muted);
  margin-bottom:20px;
}

.lesson-content{
  line-height:1.75;
}

.lesson-content h2{
  margin:22px 0 8px;
  color:var(--green-dark);
}

.lesson-content h3{
  margin:18px 0 7px;
}

.lesson-content ul{
  margin:10px 0 10px 22px;
}

.example{
  background:#f0ffe9;
  border-left:5px solid var(--green);
  padding:15px;
  margin:15px 0;
  border-radius:10px;
}

.audio-box{
  background:#f5f7fa;
  border-radius:18px;
  padding:15px;
  margin:20px 0;
}

.audio-controls{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.audio-status{
  margin-top:10px;
  color:var(--muted);
  font-size:14px;
}

/* EXERCISES */

.exercise-card{
  max-width:700px;
  margin:auto;
  background:white;
  padding:25px;
  border-radius:25px;
  box-shadow:var(--shadow);
}

.choice{
  display:block;
  width:100%;
  text-align:left;
  padding:15px;
  margin:10px 0;
  background:#f8fafc;
  border:2px solid var(--border);
  border-radius:14px;
}

.choice:hover{
  border-color:var(--blue);
}

.feedback{
  padding:15px;
  border-radius:14px;
  margin-top:15px;
  font-weight:bold;
}

.correct{
  background:#eaffdf;
  color:#2f7d00;
}

.wrong{
  background:#ffe8e8;
  color:#b00000;
}

/* PROGRESS */

.progress{
  height:15px;
  background:#e5e7eb;
  border-radius:20px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  background:var(--green);
  width:0%;
  transition:.4s;
}

.badges{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:12px;
}

.badge{
  background:white;
  border-radius:18px;
  padding:20px;
  text-align:center;
  box-shadow:var(--shadow);
}

.badge.locked{
  opacity:.4;
  filter:grayscale(1);
}

.badge-icon{
  font-size:38px;
  margin-bottom:8px;
}

/* WORK */

.work-card{
  background:white;
  padding:22px;
  border-radius:20px;
  box-shadow:var(--shadow);
}

.back-btn{
  background:#e9ecef;
  color:#333;
  padding:11px 15px;
  border-radius:12px;
  font-weight:bold;
  margin-bottom:15px;
}

/* MOBILE */

@media(max-width:650px){
  .hero{
    flex-direction:column;
    text-align:center;
  }

  .stats-grid{
    grid-template-columns:1fr;
  }

  .header-inner{
    align-items:flex-start;
  }

  .brand{
    font-size:19px;
  }

  .header-stats{
    max-width:180px;
  }
}
</style>
</head>

<body>

<!-- START -->
<section id="startScreen" class="screen active">
  <div class="start">
    <div class="start-card">
      <div class="logo">🦜 MathQuest</div>
      <p class="subtitle">
        Apprends les mathématiques, écoute les cours,
        fais des exercices et progresse à ton rythme.
      </p>

      <img
        src="matho-1.png"
        class="mascot"
        alt="Matho"
        onerror="this.style.display='none'"
      >

      <button class="main-btn" onclick="showClassScreen()">
        🚀 Commencer
      </button>
    </div>
  </div>
</section>

<!-- CLASS -->
<section id="classScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">🦜 MathQuest</div>
    </div>
  </div>

  <div class="container">
    <h1 class="section-title">Choisis ta classe</h1>
    <p class="section-subtitle">
      Sélectionne ton niveau pour découvrir tes cours et exercices.
    </p>

    <div id="classGrid" class="class-grid"></div>
  </div>
</section>

<!-- PROFILE -->
<section id="profileScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">🦜 MathQuest</div>
    </div>
  </div>

  <div class="container">
    <div class="form-card">
      <h1 class="section-title">Ton profil</h1>
      <p class="section-subtitle">
        Créons ton profil MathQuest.
      </p>

      <div class="field">
        <label>Prénom</label>
        <input id="prenom" placeholder="Ton prénom">
      </div>

      <div class="field">
        <label>Nom</label>
        <input id="nom" placeholder="Ton nom">
      </div>

      <div class="field">
        <label>Âge</label>
        <input id="age" type="number" min="5" max="25" placeholder="Ton âge">
      </div>

      <div class="field">
        <label>Choisis ton avatar</label>

        <div class="avatar-grid">
          <button id="boyAvatar" class="avatar-btn" onclick="chooseAvatar('👦')">
            👦
          </button>

          <button id="girlAvatar" class="avatar-btn" onclick="chooseAvatar('👧')">
            👧
          </button>
        </div>
      </div>

      <button class="main-btn" onclick="createProfile()">
        Continuer
      </button>
    </div>
  </div>
</section>

<!-- HOME -->
<section id="homeScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">🦜 MathQuest</div>

      <div class="header-stats">
        <div class="stat-mini">⭐ <span id="topXP">0</span> XP</div>
        <div class="stat-mini">🔥 <span id="topStreak">0</span></div>
      </div>
    </div>
  </div>

  <div class="container">

    <div class="hero">
      <img
        src="matho-1.png"
        alt="Matho"
        onerror="this.style.display='none'"
      >

      <div>
        <h1>Bonjour <span id="welcomeName">élève</span> 👋</h1>
        <p>
          Bienvenue dans MathQuest !<br>
          Classe : <strong id="homeClass">6e</strong>
        </p>
      </div>
    </div>

    <div class="stats-grid">
      <div class="big-stat">
        <strong id="homeXP">0</strong>
        XP
      </div>

      <div class="big-stat">
        <strong id="homeStreak">0</strong>
        🔥 Série
      </div>

      <div class="big-stat">
        <strong id="homeProgress">0%</strong>
        Progression
      </div>
    </div>

    <div class="menu-grid">

      <div class="menu-card" onclick="showCourses()">
        <div class="menu-icon">📚</div>
        <h3>Cours</h3>
        <p>
          Apprends les notions de ta classe et écoute les explications.
        </p>
      </div>

      <div class="menu-card" onclick="showExercises()">
        <div class="menu-icon">✏️</div>
        <h3>Exercices</h3>
        <p>
          Entraîne-toi avec des exercices interactifs.
        </p>
      </div>

      <div class="menu-card" onclick="showProgress()">
        <div class="menu-icon">📈</div>
        <h3>Ma progression</h3>
        <p>
          Consulte tes XP, ta progression et tes badges.
        </p>
      </div>

      <div class="menu-card" onclick="showWork()">
        <div class="menu-icon">📷</div>
        <h3>Montrer mon travail</h3>
        <p>
          Ajoute une photo de ton travail et explique ton raisonnement.
        </p>
      </div>

      <div class="menu-card" onclick="showProfile()">
        <div class="menu-icon">👤</div>
        <h3>Mon profil</h3>
        <p>
          Consulte tes informations et change de classe.
        </p>
      </div>

      <div class="menu-card" onclick="showRewards()">
        <div class="menu-icon">🏆</div>
        <h3>Récompenses</h3>
        <p>
          Découvre les badges que tu as débloqués.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- COURSES -->
<section id="coursesScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">📚 MathQuest</div>
    </div>
  </div>

  <div class="container">
    <button class="back-btn" onclick="showHome()">← Accueil</button>

    <h1 class="section-title">
      Cours de <span id="coursesClass"></span>
    </h1>

    <p class="section-subtitle">
      Choisis une leçon. Tu peux ensuite l'écouter avec la voix de ton téléphone.
    </p>

    <div id="courseList" class="course-list"></div>
  </div>
</section>

<!-- LESSON -->
<section id="lessonScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">🦜 MathQuest</div>
    </div>
  </div>

  <div class="container">
    <div class="lesson">

      <button class="back-btn" onclick="showCourses()">
        ← Retour aux cours
      </button>

      <div class="lesson-card">

        <h1 id="lessonTitle"></h1>

        <div class="lesson-meta" id="lessonMeta"></div>

        <div class="audio-box">

          <strong>🔊 Écouter ce cours</strong>

          <div class="audio-controls">

            <button class="small-btn" onclick="speakLesson()">
              ▶️ Écouter
            </button>

            <button class="small-btn blue-btn" onclick="pauseSpeech()">
              ⏸️ Pause
            </button>

            <button class="small-btn orange-btn" onclick="resumeSpeech()">
              ▶️ Reprendre
            </button>

            <button class="small-btn" style="background:#ff4b4b" onclick="stopSpeech()">
              ⏹️ Arrêter
            </button>

          </div>

          <div class="audio-status" id="audioStatus">
            Prêt à lire le cours.
          </div>

        </div>

        <div id="lessonContent" class="lesson-content"></div>

        <button class="main-btn" onclick="completeLesson()">
          ✅ J'ai terminé ce cours
        </button>

      </div>
    </div>
  </div>
</section>

<!-- EXERCISES -->
<section id="exerciseScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">✏️ MathQuest</div>
    </div>
  </div>

  <div class="container">
    <button class="back-btn" onclick="showHome()">← Accueil</button>

    <div class="exercise-card">

      <h1 id="exerciseTitle">Exercice</h1>

      <p id="exerciseQuestion" style="margin:20px 0;line-height:1.6"></p>

      <div id="choices"></div>

      <div id="feedback"></div>

      <button
        id="nextExerciseBtn"
        class="main-btn"
        style="display:none"
        onclick="nextExercise()"
      >
        Exercice suivant →
      </button>

    </div>
  </div>
</section>

<!-- PROGRESS -->
<section id="progressScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">📈 MathQuest</div>
    </div>
  </div>

  <div class="container">

    <button class="back-btn" onclick="showHome()">← Accueil</button>

    <h1 class="section-title">Ma progression</h1>

    <p class="section-subtitle">
      Continue tes cours et tes exercices pour progresser.
    </p>

    <div class="big-stat" style="margin-bottom:20px">
      <strong id="progressXP">0</strong>
      XP gagnés
    </div>

    <div class="big-stat" style="margin-bottom:20px">
      <strong id="progressPercent">0%</strong>

      <div class="progress" style="margin-top:12px">
        <div id="progressBar" class="progress-bar"></div>
      </div>
    </div>

    <h2 style="margin:25px 0 15px">🏆 Mes badges</h2>

    <div id="badges" class="badges"></div>

  </div>
</section>

<!-- WORK -->
<section id="workScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">📷 MathQuest</div>
    </div>
  </div>

  <div class="container">

    <button class="back-btn" onclick="showHome()">← Accueil</button>

    <div class="work-card">

      <h1 class="section-title">Montrer mon travail</h1>

      <p class="section-subtitle">
        Ajoute une photo de ton exercice et explique comment tu as raisonné.
      </p>

      <div class="field">
        <label>Photo de ton travail</label>
        <input id="workPhoto" type="file" accept="image/*">
      </div>

      <div class="field">
        <label>Mon raisonnement</label>

        <textarea
          id="workText"
          rows="7"
          placeholder="Explique les étapes que tu as suivies..."
        ></textarea>
      </div>

      <button class="main-btn" onclick="saveWork()">
        💾 Enregistrer mon travail
      </button>

      <p id="workMessage" style="margin-top:15px;color:var(--green-dark)"></p>

    </div>
  </div>
</section>

<!-- PROFILE VIEW -->
<section id="profileViewScreen" class="screen">
  <div class="header">
    <div class="header-inner">
      <div class="brand">👤 MathQuest</div>
    </div>
  </div>

  <div class="container">

    <button class="back-btn" onclick="showHome()">← Accueil</button>

    <div class="form-card">

      <h1 class="section-title">Mon profil</h1>

      <div style="font-size:60px;text-align:center;margin:20px" id="profileAvatar">
        👦
      </div>

      <p><strong>Prénom :</strong> <span id="profilePrenom"></span></p>
      <p style="margin-top:10px"><strong>Nom :</strong> <span id="profileNom"></span></p>
      <p style="margin-top:10px"><strong>Âge :</strong> <span id="profileAge"></span></p>
      <p style="margin-top:10px"><strong>Classe :</strong> <span id="profileClasse"></span></p>

      <button class="main-btn" onclick="changeClass()">
        🔄 Changer de classe
      </button>

      <button
        class="main-btn"
        style="background:#ff4b4b;box-shadow:0 5px 0 #c92828"
        onclick="resetApp()"
      >
        🗑️ Réinitialiser ma progression
      </button>

    </div>
  </div>
</section>

<script>

/* ============================================================
   MATHQUEST
   DONNÉES
============================================================ */

const classes = [
  "6e",
  "5e",
  "4e",
  "3e",
  "2nde",
  "1ère",
  "Terminale"
];

/*
  Les cours ci-dessous sont des explications originales.
  Ils sont organisés à partir des thèmes des ressources
  pédagogiques publiques du Burkina Faso.
*/

const courses = {

/* ======================= 6e ======================= */

"6e":[

{
title:"Les nombres entiers et décimaux",
text:`
<h2>Objectif</h2>
<p>Comprendre les nombres entiers et les nombres décimaux et savoir les comparer.</p>

<h2>À retenir</h2>
<p>Un nombre entier n'a pas de partie décimale. Exemple : 7, 25 ou 120.</p>
<p>Un nombre décimal possède une partie entière et éventuellement une partie décimale.</p>

<div class="example">
<strong>Exemple :</strong><br>
Dans 12,45, 12 est la partie entière et 45 représente les centièmes.
</div>

<h2>Comparer</h2>
<p>Pour comparer deux nombres décimaux, on compare d'abord leurs parties entières. Si elles sont égales, on compare les chiffres après la virgule.</p>
`,
exercise:[
["Quel nombre est le plus grand ?",["2,5","2,8","2,3","2,1"],1]
