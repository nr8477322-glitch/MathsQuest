/* ============================================================
   DONNÉES DE L'APPLICATION
============================================================ */

let userData = JSON.parse(
  localStorage.getItem("mathquestUser")
) || {
  prenom:"",
  nom:"",
  age:"",
  avatar:"👦",
  classe:"",
  xp:0,
  streak:0,
  completedLessons:[],
  completedExercises:[],
  workSaved:false
};

let selectedClass = "";
let selectedLesson = null;
let selectedExerciseIndex = 0;
let currentExercises = [];

let speech = null;


/* ============================================================
   UTILITAIRES
============================================================ */

function saveData(){
  localStorage.setItem(
    "mathquestUser",
    JSON.stringify(userData)
  );
}

function showScreen(id){
  document.querySelectorAll(".screen").forEach(screen=>{
    screen.classList.remove("active");
  });

  document.getElementById(id).classList.add("active");

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}

function showClassScreen(){
  renderClasses();
  showScreen("classScreen");
}

function renderClasses(){

  const grid = document.getElementById("classGrid");

  grid.innerHTML = classes.map(classe=>`

    <div class="class-card" onclick="selectClass('${classe}')">

      <div class="class-number">${classe}</div>

      <div class="class-desc">
        Cours + exercices + audio
      </div>

    </div>

  `).join("");
}

function selectClass(classe){

  selectedClass = classe;

  document.getElementById("prenom").value =
    userData.prenom || "";

  document.getElementById("nom").value =
    userData.nom || "";

  document.getElementById("age").value =
    userData.age || "";

  chooseAvatar(userData.avatar || "👦");

  showScreen("profileScreen");
}

function chooseAvatar(avatar){

  userData.avatar = avatar;

  document.getElementById("boyAvatar")
    .classList.toggle("selected",avatar==="👦");

  document.getElementById("girlAvatar")
    .classList.toggle("selected",avatar==="👧");
}

function createProfile(){

  const prenom =
    document.getElementById("prenom").value.trim();

  const nom =
    document.getElementById("nom").value.trim();

  const age =
    document.getElementById("age").value.trim();

  if(!prenom){
    alert("Entre ton prénom.");
    return;
  }

  if(!nom){
    alert("Entre ton nom.");
    return;
  }

  userData.prenom = prenom;
  userData.nom = nom;
  userData.age = age;
  userData.classe = selectedClass;

  saveData();

  updateHome();

  showScreen("homeScreen");
}


/* ============================================================
   HOME
============================================================ */

function updateHome(){

  const classe =
    userData.classe || "6e";

  document.getElementById("welcomeName")
    .textContent = userData.prenom || "élève";

  document.getElementById("homeClass")
    .textContent = classe;

  document.getElementById("homeXP")
    .textContent = userData.xp;

  document.getElementById("topXP")
    .textContent = userData.xp;

  document.getElementById("homeStreak")
    .textContent = userData.streak;

  document.getElementById("topStreak")
    .textContent = userData.streak;

  const list =
    courses[classe] || [];

  const completed =
    list.filter((_,index)=>
      userData.completedLessons.includes(
        classe + "-" + index
      )
    ).length;

  const percent =
    list.length ?
    Math.round(completed/list.length*100) :
    0;

  document.getElementById("homeProgress")
    .textContent = percent + "%";
}

function showHome(){
  updateHome();
  showScreen("homeScreen");
}


/* ============================================================
   COURS
============================================================ */

function showCourses(){

  const classe =
    userData.classe || "6e";

  document.getElementById("coursesClass")
    .textContent = classe;

  const list =
    courses[classe] || [];

  const container =
    document.getElementById("courseList");

  container.innerHTML =
    list.map((course,index)=>{

      const completed =
        userData.completedLessons.includes(
          classe + "-" + index
        );

      return `

        <div class="course-card">

          <h3>
            ${completed ? "✅" : "📘"}
            ${index+1}. ${course.title}
          </h3>

          <p>
            Cours de ${classe} •
            Explication + écoute + exercice
          </p>

          <button
            class="small-btn"
            onclick="openLesson(${index})"
          >
            📖 Ouvrir le cours
          </button>

        </div>

      `;

    }).join("");

  showScreen("coursesScreen");
}

function openLesson(index){

  const classe =
    userData.classe || "6e";

  selectedLesson = index;

  const course =
    courses[classe][index];

  document.getElementById("lessonTitle")
    .textContent = course.title;

  document.getElementById("lessonMeta")
    .textContent =
      "Mathématiques • " +
      classe +
      " • Leçon " +
      (index+1);

  document.getElementById("lessonContent")
    .innerHTML = course.text;

  stopSpeech();

  document.getElementById("audioStatus")
    .textContent =
      "Prêt à lire le cours.";

  showScreen("lessonScreen");
}


/* ============================================================
   AUDIO / SYNTHÈSE VOCALE
============================================================ */

function getLessonPlainText(){

  const element =
    document.getElementById("lessonContent");

  return element.innerText ||
         element.textContent ||
         "";
}

function speakLesson(){

  if(!("speechSynthesis" in window)){
    alert(
      "La lecture vocale n'est pas disponible sur ce navigateur."
    );
    return;
  }

  stopSpeech();

  speech =
    new SpeechSynthesisUtterance(
      getLessonPlainText()
    );

  speech.lang = "fr-FR";
  speech.rate = 0.9;
  speech.pitch = 1;

  speech.onstart = function(){
    document.getElementById("audioStatus")
      .textContent =
      "🔊 Matho lit le cours...";
  };

  speech.onend = function(){
    document.getElementById("audioStatus")
      .textContent =
      "✅ Lecture terminée.";
  };

  speech.onerror = function(){
    document.getElementById("audioStatus")
      .textContent =
      "⚠️ La lecture vocale a rencontré un problème.";
  };

  window.speechSynthesis.speak(speech);
}

function pauseSpeech(){

  if(
    "speechSynthesis" in window &&
    window.speechSynthesis.speaking
  ){

    window.speechSynthesis.pause();

    document.getElementById("audioStatus")
      .textContent =
      "⏸️ Lecture en pause.";
  }
}

function resumeSpeech(){

  if(
    "speechSynthesis" in window &&
    window.speechSynthesis.paused
  ){

    window.speechSynthesis.resume();

    document.getElementById("audioStatus")
      .textContent =
      "▶️ Lecture reprise.";
  }
}

function stopSpeech(){

  if("speechSynthesis" in window){

    window.speechSynthesis.cancel();

    const status =
      document.getElementById("audioStatus");

    if(status){
      status.textContent =
        "⏹️ Lecture arrêtée.";
    }
  }
}


/* ============================================================
   FIN DE COURS
============================================================ */

function completeLesson(){

  const classe =
    userData.classe || "6e";

  const id =
    classe + "-" + selectedLesson;

  if(!userData.completedLessons.includes(id)){

    userData.completedLessons.push(id);

    userData.xp += 10;

    userData.streak += 1;

    saveData();

    alert(
      "🎉 Cours terminé ! +10 XP"
    );

  }else{

    alert(
      "Ce cours est déjà terminé."
    );
  }

  updateHome();
  showCourses();
}


/* ============================================================
   EXERCICES
============================================================ */

function showExercises(){

  const classe =
    userData.classe || "6e";

  currentExercises =
    courses[classe] || [];

  selectedExerciseIndex = 0;

  loadExercise();

  showScreen("exerciseScreen");
}

function loadExercise(){

  const classe =
    userData.classe || "6e";

  if(selectedExerciseIndex >= currentExercises.length){

    alert(
      "🎉 Bravo ! Tu as terminé les exercices disponibles."
    );

    showHome();

    return;
  }

  const course =
    currentExercises[selectedExerciseIndex];

  const exercise =
    course.exercise &&
    course.exercise[0];

  if(!exercise){

    selectedExerciseIndex++;

    loadExercise();

    return;
  }

  document.getElementById("exerciseTitle")
    .textContent =
      "✏️ " + course.title;

  document.getElementById("exerciseQuestion")
    .textContent =
      exercise[0];

  const choices =
    document.getElementById("choices");

  choices.innerHTML =
    exercise[1].map((answer,index)=>`

      <button
        class="choice"
        onclick="answerExercise(${index})"
      >
        ${String.fromCharCode(65+index)}. ${answer}
      </button>

    `).join("");

  document.getElementById("feedback")
    .innerHTML = "";

  document.getElementById("nextExerciseBtn")
    .style.display = "none";
}

function answerExercise(answerIndex){

  const course =
    currentExercises[selectedExerciseIndex];

  const exercise =
    course.exercise[0];

  const correct =
    exercise[2];

  const buttons =
    document.querySelectorAll(".choice");

  buttons.forEach(button=>{
    button.disabled = true;
  });

  const feedback =
    document.getElementById("feedback");

  if(answerIndex === correct){

    feedback.className =
      "feedback correct";

    feedback.innerHTML =
      "🎉 Bonne réponse ! +5 XP";

    const exerciseId =
      userData.classe +
      "-" +
      selectedExerciseIndex;

    if(!userData.completedExercises.includes(exerciseId)){

      userData.completedExercises.push(
        exerciseId
      );

      userData.xp += 5;

      userData.streak += 1;

      saveData();
    }

  }else{

    feedback.className =
      "feedback wrong";

    feedback.innerHTML =
      "Pas grave ! Relis le cours et réessaie. 💪";
  }

  document.getElementById("nextExerciseBtn")
    .style.display = "block";

  updateHome();
}

function nextExercise(){

  selectedExerciseIndex++;

  loadExercise();
}


/* ============================================================
   PROGRESSION
============================================================ */

function showProgress(){

  const classe =
    userData.classe || "6e";

  const list =
    courses[classe] || [];

  const completed =
    list.filter((_,index)=>
      userData.completedLessons.includes(
        classe + "-" + index
      )
    ).length;

  const percent =
    list.length ?
    Math.round(completed/list.length*100) :
    0;

  document.getElementById("progressXP")
    .textContent = userData.xp;

  document.getElementById("progressPercent")
    .textContent = percent + "%";

  document.getElementById("progressBar")
    .style.width = percent + "%";

  renderBadges();

  showScreen("progressScreen");
}

function showRewards(){
  showProgress();
}

function renderBadges(){

  const badges = [

    {
      icon:"🌱",
      title:"Premier pas",
      description:"Terminer ton premier cours.",
      unlocked:
        userData.completedLessons.length >= 1
    },

    {
      icon:"⭐",
      title:"50 XP",
      description:"Gagner 50 XP.",
      unlocked:
        userData.xp >= 50
    },

    {
      icon:"🔥",
      title:"Série",
      description:"Atteindre 5 séries.",
      unlocked:
        userData.streak >= 5
    },

    {
      icon:"📚",
      title:"Apprenti",
      description:"Terminer 5 cours.",
      unlocked:
        userData.completedLessons.length >= 5
    },

    {
      icon:"🏆",
      title:"Champion",
      description:"Gagner 100 XP.",
      unlocked:
        userData.xp >= 100
    },

    {
      icon:"🚀",
      title:"MathQuest",
      description:"Atteindre 200 XP.",
      unlocked:
        userData.xp >= 200
    }

  ];

  document.getElementById("badges")
    .innerHTML =
      badges.map(badge=>`

        <div class="badge ${badge.unlocked ? "" : "locked"}">

          <div class="badge-icon">
            ${badge.icon}
          </div>

          <strong>
            ${badge.title}
          </strong>

          <p style="margin-top:7px;color:#667085;font-size:13px">
            ${badge.description}
          </p>

        </div>

      `).join("");
}


/* ============================================================
   MONTRER MON TRAVAIL
============================================================ */

function showWork(){
  showScreen("workScreen");
}

function saveWork(){

  const text =
    document.getElementById("workText").value.trim();

  const file =
    document.getElementById("workPhoto").files[0];

  if(!file && !text){

    alert(
      "Ajoute une photo ou explique ton raisonnement."
    );

    return;
  }

  userData.workSaved = true;

  userData.xp += 5;

  saveData();

  document.getElementById("workMessage")
    .textContent =
      "✅ Ton travail a été enregistré sur cet appareil. +5 XP";

  updateHome();
}


/* ============================================================
   PROFIL
============================================================ */

function showProfile(){

  document.getElementById("profileAvatar")
    .textContent = userData.avatar || "👦";

  document.getElementById("profilePrenom")
    .textContent = userData.prenom || "";

  document.getElementById("profileNom")
    .textContent = userData.nom || "";

  document.getElementById("profileAge")
    .textContent = userData.age || "";

  document.getElementById("profileClasse")
    .textContent = userData.classe || "";

  showScreen("profileViewScreen");
}

function changeClass(){

  renderClasses();

  showScreen("classScreen");
}

function resetApp(){

  const confirmReset =
    confirm(
      "Veux-tu vraiment supprimer ta progression sur cet appareil ?"
    );

  if(!confirmReset) return;

  localStorage.removeItem(
    "mathquestUser"
  );

  location.reload();
}


/* ============================================================
   INITIALISATION
============================================================ */

function initializeApp(){

  /*
    Si aucun profil n'existe :
    écran de départ.

    Si un profil existe :
    accueil directement.
  */

  if(userData.classe){

    updateHome();

    showScreen("homeScreen");

  }else{

    showScreen("startScreen");
  }
}

initializeApp();

</script>

