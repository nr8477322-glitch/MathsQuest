/* =========================================================
   RÉINITIALISATION
========================================================= */

function resetApp(){

  const confirmation =
    confirm(
      "Réinitialiser ton profil et toute ta progression ?"
    );


  if(!confirmation) return;


  localStorage.removeItem(
    "mathquestUser"
  );


  location.reload();
}


/* =========================================================
   INITIALISATION
========================================================= */

function init(){

  loadVoices();


  if(
    user.prenom &&
    user.classe
  ){

    showHome();

  }else{

    showScreen("startScreen");

  }
}


init();

