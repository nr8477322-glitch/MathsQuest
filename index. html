function showRewards(){

  renderBadges();

  document.getElementById("rewardsList")
    .innerHTML =
    document.getElementById("badgeList")
    .innerHTML;


  showScreen("rewardsScreen");
}


/* =========================================================
   MON TRAVAIL
========================================================= */

function previewWork(event){

  const file =
    event.target.files[0];

  const image =
    document.getElementById("workPreview");


  if(!file) return;


  const reader =
    new FileReader();


  reader.onload = function(){

    image.src =
      reader.result;

    image.style.display =
      "block";

  };


  reader.readAsDataURL(file);
}


function showWork(){

  document.getElementById("workText")
    .value =
    user.workText || "";


  showScreen("workScreen");
}


function saveWork(){

  user.workText =
    document.getElementById("workText")
    .value;


  user.workSaved = true;

  user.xp += 5;

  save();


  document.getElementById("workMsg")
    .innerHTML = `

      <div class="notice">

        ✅ Ton travail a été enregistré
        sur cet appareil.
        <br>
        ⭐ +5 XP

      </div>

    `;
}


