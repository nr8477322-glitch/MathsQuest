/* =========================================================
   ÉTAT DE L'APPLICATION
========================================================= */

let user =
JSON.parse(localStorage.getItem("mathquestUser") || "null")
||
{
  prenom:"",
  nom:"",
  age:"",
  avatar:"👦",
  classe:"",
  xp:0,
  streak:0,
  completedLessons:[],
  completedExercises:[],
  lastActivity:"",
  workText:"",
  workSaved:false
};

let selectedClass = user.classe || "";
let selectedLesson = null;
let exerciseIndex = 0;
let currentExercises = [];
let selectedAvatar = user.avatar || "👦";
let voices = [];


/* =========================================================
   SAUVEGARDE
========================================================= */

function save(){
  localStorage.setItem(
    "mathquestUser",
    JSON.stringify(user)
  );
}


/* =========================================================
   NAVIGATION
========================================================= */

function showScreen(id){

  document
    .querySelectorAll(".screen")
    .forEach(screen=>{
      screen.classList.remove("active");
    });

  document
    .getElementById(id)
    .classList.add("active");

  window.scrollTo(0,0);
}


/* =========================================================
   CLASSES
========================================================= */

function showClassScreen(){

  renderClasses();

  showScreen("classScreen");
}


function renderClasses(){

  document.getElementById("classes").innerHTML =
  Object.keys(courses)
  .map(classe=>`

    <button
      class="class-btn"
      onclick="selectClass('${classe}')"
    >
      🎓
      <br>
      ${classe}
    </button>

  `)
  .join("");
}


function selectClass(classe){

  selectedClass = classe;

  if(user.prenom){

    user.classe = classe;

    save();

    updateHome();

    showHome();

  }else{

    document.getElementById("profileClass")
      .textContent = classe;

    showScreen("profileScreen");
  }
}


/* =========================================================
   PROFIL
========================================================= */

function chooseAvatar(avatar){

  selectedAvatar = avatar;

  document
    .getElementById("boy")
    .classList.toggle(
      "selected",
      avatar==="👦"
    );

  document
    .getElementById("girl")
    .classList.toggle(
      "selected",
      avatar==="👧"
    );
}


function createProfile(){

  const prenom =
    document.getElementById("prenom")
    .value
    .trim();

  const nom =
    document.getElementById("nom")
    .value
    .trim();

  const age =
    document.getElementById("age")
    .value;

  if(!prenom || !nom){

    alert("Entre ton prénom et ton nom.");

    return;
  }

  user.prenom = prenom;
  user.nom = nom;
  user.age = age;
  user.avatar = selectedAvatar;
  user.classe = selectedClass;

  save();

  showHome();
}


/* =========================================================
   ACCUEIL
========================================================= */

function showHome(){

  updateHome();

  showScreen("homeScreen");
}


function updateHome(){

  document.getElementById("topXp")
    .textContent = user.xp;

  document.getElementById("topStreak")
    .textContent = user.streak;


  document.getElementById("welcome")
    .textContent =
    `Bonjour ${user.prenom || ""} ${user.avatar}`;


  const total =
    Object.values(courses)
    .flat()
    .length;

  const done =
    user.completedLessons.length;

  const percent =
    Math.round((done / total) * 100);


  document.getElementById("homeBar")
    .style.width = percent + "%";

  document.getElementById("homeProgress")
    .textContent =
    percent + "% du parcours";


  let message;

  if(percent >= 80){

    message =
      "Tu es incroyable ! Continue jusqu'au bout. 🏆";

  }else if(percent >= 40){

    message =
      "Ton aventure avance très bien ! Continue comme ça. 🚀";

  }else{

    message =
      "Chaque leçon te rend plus fort en maths ! 💪";
  }

  document.getElementById("mathoMessage")
    .textContent = message;


  const next =
    Object.entries(courses)
    .flatMap(([classe,lessons])=>
      lessons.map((lesson,index)=>({
        classe,
        index,
        lesson
      }))
    )
    .find(item=>
      !user.completedLessons.includes(
        item.classe + "-" + item.index
      )
    );


  document.getElementById("nextMission")
    .textContent =
    next
    ?
    `Prochaine étape : ${next.lesson[0]} (${next.classe}).`
    :
    "🎉 Toutes les leçons actuelles sont terminées !";
}


/* =========================================================
   COURS
========================================================= */

function showCourses(){

  const lessons =
    courses[user.classe] || [];

  document.getElementById("coursesTitle")
    .textContent =
    `Cours de ${user.classe}`;


  document.getElementById("courseList")
    .innerHTML =
    lessons
    .map((lesson,index)=>{

      const key =
        user.classe + "-" + index;

      const done =
        user.completedLessons.includes(key);

      return `

        <div class="course">

          <div>

            <h3>
              ${done ? "✅" : "📘"}
              ${index+1}. ${lesson[0]}
            </h3>

            <p>
              ${lesson[1]}
            </p>

          </div>

          <button
            class="small-btn"
            onclick="openLesson(${index})"
          >
            ${done ? "Revoir" : "Apprendre"}
          </button>

        </div>

      `;

    })
    .join("");


  showScreen("coursesScreen");
}


/* =========================================================
   LEÇON
========================================================= */

function openLesson(index){

  selectedLesson = index;

  const lesson =
    courses[user.classe][index];


  document.getElementById("lessonContent")
    .innerHTML = `

      <h2>${lesson[0]}</h2>

      <div class="pill">
        🎓 ${user.classe}
        · Leçon ${index+1}
      </div>


      <div class="audio">

        <b>🔊 Lecture du cours</b>

        <div class="field">

          <label>Voix</label>

          <select id="voiceSelect"></select>

        </div>


        <label>
          Vitesse :
          <span id="rateValue">0.9</span>
        </label>

        <input
          id="rate"
          class="range"
          type="range"
          min="0.6"
          max="1.2"
          step="0.05"
          value="0.9"
          oninput="
            document.getElementById('rateValue')
            .textContent=this.value
          "
        >


        <div class="audio-buttons">

          <button onclick="speakLesson()">
            ▶️ Écouter
          </button>

          <button onclick="pauseSpeech()">
            ⏸️ Pause
          </button>

          <button onclick="resumeSpeech()">
            ▶️ Reprendre
          </button>

          <button onclick="stopSpeech()">
            ⏹️ Stop
          </button>

        </div>

      </div>


      <h3>🎯 Objectif</h3>

      <p>
        Comprendre
        ${lesson[0].toLowerCase()}
        et savoir appliquer la notion.
      </p>


      <h3>📚 Explication</h3>

      <p>
        ${lesson[1]}
      </p>


      <h3>🧠 Exemple / question</h3>

      <div class="example">
        ${lesson[2]}
      </div>


      <h3>💡 À retenir</h3>

      <p>
        ${lesson[3]}
      </p>


      <button
        class="btn primary"
        onclick="completeLesson()"
      >
        ✅ J'ai terminé la leçon (+10 XP)
      </button>

    `;


  populateVoices();

  showScreen("lessonScreen");
}


/* =========================================================
   VOIX
========================================================= */

function getSpeechText(){

  const lesson =
    courses[user.classe][selectedLesson];

  return `

    Bonjour, je suis Matho.

    Aujourd'hui nous allons apprendre :
    ${lesson[0]}.

    Objectif :
    comprendre cette notion.

    ${lesson[1]}

    Voici une question :
    ${lesson[2]}

    À retenir :
    ${lesson[3]}.

    Bravo ! Continue tes efforts.

  `;
}


function loadVoices(){

  voices =
    window.speechSynthesis
    .getVoices() || [];
}


function populateVoices(){

  loadVoices();

  const select =
    document.getElementById("voiceSelect");

  if(!select) return;


  const frenchVoices =
    voices.filter(
      voice =>
      voice.lang &&
      voice.lang
        .toLowerCase()
        .startsWith("fr")
    );


  const list =
    frenchVoices.length
    ? frenchVoices
    : voices;


  select.innerHTML =
    list
    .map(voice=>`

      <option value="${voice.name
        .replace(/"/g,"&quot;")}">

        ${voice.name}
        — ${voice.lang}

      </option>

    `)
    .join("");


  const best =
    frenchVoices.find(
      voice =>
      /google|microsoft|france|français|french/i
      .test(voice.name)
    );


  if(best){

    select.value = best.name;

  }
}


function speakLesson(){

  stopSpeech();

  const utterance =
    new SpeechSynthesisUtterance(
      getSpeechText()
    );


  const voiceName =
    document.getElementById("voiceSelect")
    ?.value;


  utterance.voice =
    voices.find(
      voice => voice.name === voiceName
    )
    ||
    voices.find(
      voice =>
      voice.lang &&
      voice.lang
        .toLowerCase()
        .startsWith("fr")
    )
    ||
    null;


  utterance.lang = "fr-FR";

  utterance.rate =
    Number(
      document.getElementById("rate")
      ?.value || 0.9
    );

  utterance.pitch = 1;

  utterance.volume = 1;


  speechSynthesis.speak(
    utterance
  );
}


function pauseSpeech(){

  speechSynthesis.pause();
}


function resumeSpeech(){

  speechSynthesis.resume();
}


function stopSpeech(){

  speechSynthesis.cancel();
}


speechSynthesis.addEventListener(
  "voiceschanged",
  loadVoices
);


/* =========================================================
   XP + SÉRIE
========================================================= */

function updateActivity(){

  const today =
    new Date()
    .toISOString()
    .slice(0,10);


  if(user.lastActivity !== today){

    const yesterday =
      new Date(
        Date.now() - 86400000
      )
      .toISOString()
      .slice(0,10);


    if(user.lastActivity === yesterday){

      user.streak++;

    }else{

      user.streak = 1;

    }


    user.lastActivity = today;
  }


  save();
}


/* =========================================================
   TERMINER UNE LEÇON
========================================================= */

function completeLesson(){

  const key =
    user.classe +
    "-" +
    selectedLesson;


  if(
    !user.completedLessons.includes(key)
  ){

    user.completedLessons.push(key);

    user.xp += 10;

    updateActivity();

  }


  showCourses();
}


/* =========================================================
   EXERCICES
========================================================= */

function showExercises(){

  currentExercises =
    (courses[user.classe] || [])
    .map((lesson,index)=>({

      index,
      question:lesson[2],
      answer:lesson[3]

    }));


  exerciseIndex = 0;

  loadExercise();

  showScreen("exerciseScreen");
}


function loadExercise(){

  const exercise =
    currentExercises[exerciseIndex];


  if(!exercise){

    showHome();

    return;
  }


  const choices =
    createChoices(
      exercise.answer
    );


  document.getElementById("exerciseBox")
    .innerHTML = `

      <div class="pill">
        Exercice
        ${exerciseIndex+1}
        /
        ${currentExercises.length}
      </div>


      <h2>
        ${exercise.question}
      </h2>


      <p class="subtitle">
        Choisis la bonne réponse.
      </p>


      ${choices.map(choice=>`

        <button
          class="choice"
          onclick="answerExercise(
            this,
            '${choice
              .replace(/'/g,"\\'")
            }'
          )"
        >
          ${choice}
        </button>

      `).join("")}


      <div id="feedback"></div>

    `;
}


function createChoices(answer){

  const choices = [answer];

  const pool = [

    "Oui",
    "Non",
    "2",
    "3",
    "5",
    "7",
    "8",
    "10",
    "11",
    "12",
    "30",
    "90°",
    "1000 F",
    "1/2",
    "3/4",
    "5x",
    "2x",
    "ax+b",
    "Direction",
    "Côté adjacent",
    "Proportionnelles",
    "Une",
    "Deux",
    "Non",
    "1",
    "2"
  ];


  for(const item of pool){

    if(!choices.includes(item)){

      choices.push(item);

    }

    if(choices.length >= 4){

      break;
    }
  }


  return choices.sort(
    ()=>Math.random()-.5
  );
}


function answerExercise(
  button,
  value
){

  const exercise =
    currentExercises[exerciseIndex];


  const correct =
    value === exercise.answer;


  document
    .querySelectorAll(".choice")
    .forEach(
      button => button.disabled=true
    );


  button.classList.add(
    correct
    ? "correct"
    : "wrong"
  );


  const feedback =
    document.getElementById("feedback");


  feedback.innerHTML = `

    <div
      class="feedback"
      style="
        background:
        ${correct
          ? "#efffe7"
          : "#fff0f0"}
      "
    >

      ${
        correct
        ?
        "🎉 Bravo ! +10 XP"
        :
        "❌ Pas encore. La réponse attendue est : "
        + exercise.answer
      }

    </div>


    <button
      class="btn primary"
      onclick="nextExercise()"
    >

      ${
        exerciseIndex ===
        currentExercises.length-1
        ?
        "Terminer"
        :
        "Question suivante →"
      }

    </button>

  `;


  if(correct){

    const key =
      user.classe +
      "-e-" +
      exercise.index;


    if(
      !user.completedExercises
      .includes(key)
    ){

      user.completedExercises
        .push(key);

      user.xp += 10;

      updateActivity();

    }

  }
}


function nextExercise(){

  exerciseIndex++;


  if(
    exerciseIndex >=
    currentExercises.length
  ){

    showHome();

  }else{

    loadExercise();

  }
}


/* =========================================================
   PROGRESSION
========================================================= */

function showProgress(){

  const total =
    Object.values(courses)
    .flat()
    .length;


  const percent =
    Math.round(
      user.completedLessons.length /
      total *
      100
    );


